# OpenAI Organization API key (requires Org Admin role for usage/costs endpoints)
OPENAI_API_KEY=sk-org-...

# Kintone subdomain (e.g. "yourcompany" for yourcompany.cybozu.com)
KINTONE_SUBDOMAIN=yourcompany

# Kintone API token (set per-app or a shared token with record-read permission)
KINTONE_API_TOKEN=your_kintone_api_token_here
